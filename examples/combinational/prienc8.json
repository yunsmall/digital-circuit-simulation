{
  "$schema": "../../schemas/circuit.schema.json",
  "$meta": {
    "kind": "circuit",
    "format": 1,
    "description": "优先编码器演示：0b00101000 最高位是 bit5，library/prienc8 输出 5、valid=1"
  },
  "definitions": {
    "prienc8": "../../library/prienc8.json"
  },
  "nets": ["d", "in0", "in1", "in2", "in3", "in4", "in5", "in6", "in7", "out", "valid"],
  "components": [
    {
      "type": "constant",
      "name": "pattern",
      "params": { "bit_width": "8", "value": "40" },
      "connections": { "out": "d" }
    },
    {
      "type": "split",
      "name": "split_pattern",
      "params": { "num_bits": "8" },
      "connections": {
        "in": "d",
        "out0": "in0", "out1": "in1", "out2": "in2", "out3": "in3",
        "out4": "in4", "out5": "in5", "out6": "in6", "out7": "in7"
      }
    },
    {
      "type": "composite",
      "name": "u_prienc",
      "params": { "definition": "prienc8" },
      "connections": {
        "in0": "in0", "in1": "in1", "in2": "in2", "in3": "in3",
        "in4": "in4", "in5": "in5", "in6": "in6", "in7": "in7",
        "out": "out", "valid": "valid"
      }
    },
    {
      "type": "display",
      "name": "index_display",
      "params": { "bit_width": "3", "kind": "text", "digits": "1" },
      "connections": { "in": "out" }
    },
    {
      "type": "display",
      "name": "valid_led",
      "params": { "bit_width": "1", "kind": "led", "digits": "1" },
      "connections": { "in": "valid" }
    }
  ]
}
