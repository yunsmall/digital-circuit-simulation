@PACKAGE_INIT@

# 公开头文件直接 include 了 nlohmann/json.hpp（CircuitSerializer/ParamFlatten）
# 和 elfio（ElfLoader），消费者也必须能找到这两个包
include(CMakeFindDependencyMacro)
find_dependency(nlohmann_json CONFIG)
find_dependency(elfio CONFIG)

# 默认（LLVM + 静态库）安装：dcs_lib 的 PRIVATE 后端库会以
# $<LINK_ONLY:clangFrontend> 之类出现在导出接口里，不先找到 LLVM/Clang
# 就会在加载 dcsTargets 时报 "target not found"。下游需要能定位到
# 与安装 dcs 时同一套 LLVM（必要时给 -DLLVM_DIR=.../lib/cmake/llvm）
if(@DCS_EXPORT_NEEDS_LLVM@)
    # 带上构建时的主.次版本：LLVM 的 ConfigVersion 本身也只认主.次相同，
    # 补丁不小于构建版本；不写版本会静默接受任意大版本
    find_dependency(LLVM @DCS_LLVM_ABI_VERSION@ CONFIG)
    find_dependency(Clang @DCS_LLVM_ABI_VERSION@ CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/dcsTargets.cmake")

# 静态 TCC 构建：dcs_lib 的接口里不带构建机的 libtcc 绝对路径
# （target_link_libraries 用 $<BUILD_INTERFACE:...>），在安装环境重新定位。
# 必须放在 include(dcsTargets) 之后，目标此时才存在
if(@DCS_EXPORT_NEEDS_TCC@)
    if(NOT DCS_TCC_LIBRARY)
        find_library(DCS_TCC_LIBRARY NAMES tcc libtcc)
    endif()
    if(NOT DCS_TCC_LIBRARY)
        message(FATAL_ERROR "这个 dcs 安装使用静态 TCC 后端：找不到 libtcc，"
                            "请安装 libtcc-dev 或设置 -DDCS_TCC_LIBRARY=<路径>")
    endif()
    set_property(TARGET dcs::dcs_lib APPEND PROPERTY INTERFACE_LINK_LIBRARIES "${DCS_TCC_LIBRARY}")
endif()

# 安装包通常只带一个构建配置（例如 Release）。VS 这类多配置生成器会为
# Debug/MinSizeRel 等配置查找 IMPORTED_LOCATION，缺失时直接报错；把缺失的
# 配置映射到已安装的那个，消费者不用迁就安装时的配置
get_target_property(_dcs_configs dcs::dcs_lib IMPORTED_CONFIGURATIONS)
if(_dcs_configs)
    list(GET _dcs_configs 0 _dcs_default_config)
    foreach(_cfg DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
        if(NOT _cfg IN_LIST _dcs_configs)
            set_property(TARGET dcs::dcs_lib PROPERTY MAP_IMPORTED_CONFIG_${_cfg} ${_dcs_default_config})
        endif()
    endforeach()
endif()
unset(_dcs_configs)
unset(_dcs_default_config)

# 静态库构建下，元件靠静态初始化器自注册：链接器会丢掉没有被引用的 .obj，
# 注册也就不会执行。消费者必须整库归档：
#   target_link_libraries(app PRIVATE $<LINK_LIBRARY:WHOLE_ARCHIVE,dcs::dcs_lib>)
# 共享库构建（DCS_SHARED_LIB=ON）直接用 dcs::dcs_lib 即可。

check_required_components(dcs)
