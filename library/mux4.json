{
  "$schema": "../schemas/circuit.schema.json",
  "$meta": {
    "kind": "blueprint",
    "format": 1,
    "name": "mux4",
    "author": "dcs",
    "description": "4 选 1 多路选择器：位宽由 bit_width 参数决定，默认 8"
  },
  "params": { "bit_width": "8" },
  "nets": ["sel0", "sel1", "in0", "in1", "in2", "in3", "out"],
  "components": [
    {
      "type": "mux",
      "name": "mux4",
      "params": { "n_selects": "2", "bit_width": "${bit_width}" },
      "connections": {
        "sel0": "sel0", "sel1": "sel1",
        "in0": "in0", "in1": "in1", "in2": "in2", "in3": "in3",
        "out": "out"
      }
    }
  ],
  "expose": {
    "inputs": {
      "sel0": "sel0", "sel1": "sel1",
      "in0": { "net": "in0", "width": "${bit_width}" },
      "in1": { "net": "in1", "width": "${bit_width}" },
      "in2": { "net": "in2", "width": "${bit_width}" },
      "in3": { "net": "in3", "width": "${bit_width}" }
    },
    "outputs": { "out": { "net": "out", "width": "${bit_width}" } }
  }
}
