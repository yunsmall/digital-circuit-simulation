{
  "$meta": {
    "kind": "circuit",
    "format": 1,
    "description": "最小裸机 SoC：RISC-V CPU（默认 RV32，RV64 请给 riscv_cpu 加 \"xlen\": \"64\"）+ 64KB Wishbone 内存，没有外设；配合 dcs_soc --elf 跑 riscv-tests/裸机程序，按 tohost 判定结果"
  },
  "nets": ["clk", "rst", "irq", "mti", "msi", "wb_adr", "wb_dat_o", "wb_dat_i",
           "wb_we", "wb_sel", "wb_stb", "wb_cyc", "wb_ack", "halted"],
  "components": [
    {
      "type": "clkgen",
      "name": "clkgen",
      "params": {"high_ticks": "1", "low_ticks": "1"},
      "connections": {"clk": "clk"}
    },
    {
      "type": "riscv_cpu",
      "name": "cpu",
      "params": {},
      "connections": {
        "clk": "clk", "rst": "rst", "irq": "irq", "mti": "mti", "msi": "msi",
        "wb_dat_i": "wb_dat_i", "wb_ack_i": "wb_ack",
        "wb_adr_o": "wb_adr", "wb_dat_o": "wb_dat_o", "wb_we_o": "wb_we",
        "wb_sel_o": "wb_sel", "wb_stb_o": "wb_stb", "wb_cyc_o": "wb_cyc",
        "halted": "halted"
      }
    },
    {
      "type": "wishbone_mem",
      "name": "mem",
      "params": {"addr_width": "16", "data_width": "32"},
      "connections": {
        "wb_adr_i": "wb_adr", "wb_dat_i": "wb_dat_o", "wb_we_i": "wb_we",
        "wb_sel_i": "wb_sel", "wb_stb_i": "wb_stb", "wb_cyc_i": "wb_cyc",
        "clk": "clk", "wb_dat_o": "wb_dat_i", "wb_ack_o": "wb_ack"
      }
    }
  ]
}
